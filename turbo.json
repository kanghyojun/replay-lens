{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "backend#build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**"
      ],
      "env": [
        "DATABASE_URL",
        "BNET_CLIENT_ID",
        "BNET_CLIENT_SECRET",
        "BATTLENET_CLIENT_ID",
        "BATTLENET_CLIENT_SECRET",
        "BATTLENET_API_URL",
        "BNET_CALLBACK_URL",
        "BNET_REGION",
        "SESSION_SECRET",
        "FRONTEND_URL",
        "CORS_ORIGIN"
      ]
    },
    "frontend#build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**"
      ],
      "env": [
        "NEXT_PUBLIC_BACKEND_URL"
      ]
    },
    "backend#dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "DATABASE_URL",
        "BNET_CLIENT_ID",
        "BNET_CLIENT_SECRET",
        "BATTLENET_CLIENT_ID",
        "BATTLENET_CLIENT_SECRET",
        "BATTLENET_API_URL",
        "BNET_CALLBACK_URL",
        "BNET_REGION",
        "SESSION_SECRET",
        "FRONTEND_URL",
        "CORS_ORIGIN"
      ]
    },
    "frontend#dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "NEXT_PUBLIC_BACKEND_URL"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "check-types": {
      "dependsOn": [
        "^check-types"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
